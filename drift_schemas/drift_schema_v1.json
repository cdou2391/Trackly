  "fixed_sql": [
    {
      "name": "categories",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"categories\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"icon\" TEXT NULL, \"sort_order\" INTEGER NOT NULL, \"is_system\" INTEGER NOT NULL CHECK (\"is_system\" IN (0, 1)), PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "recurring_items",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"recurring_items\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"type\" TEXT NOT NULL, \"amount\" REAL NOT NULL CHECK(\"amount\" >= 0.0), \"currency_code\" TEXT NOT NULL, \"frequency\" TEXT NOT NULL, \"interval\" INTEGER NOT NULL DEFAULT 1 CHECK(\"interval\" >= 1), \"start_date\" TEXT NOT NULL, \"next_due_date\" TEXT NOT NULL, \"status\" TEXT NOT NULL, \"is_trial\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_trial\" IN (0, 1)), \"trial_end_date\" TEXT NULL, \"reminders_enabled\" INTEGER NOT NULL DEFAULT 1 CHECK (\"reminders_enabled\" IN (0, 1)), \"reminder_days_before\" INTEGER NOT NULL DEFAULT 3 CHECK(\"reminder_days_before\" >= 0), \"category_id\" TEXT NULL REFERENCES categories (id) ON DELETE SET NULL, \"notes\" TEXT NULL, \"logo_key\" TEXT NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "payments",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"payments\" (\"id\" TEXT NOT NULL, \"recurring_item_id\" TEXT NOT NULL REFERENCES recurring_items (id) ON DELETE CASCADE, \"amount\" REAL NOT NULL CHECK(\"amount\" >= 0.0), \"currency_code\" TEXT NOT NULL, \"due_date\" TEXT NOT NULL, \"paid_date\" TEXT NULL, \"status\" TEXT NOT NULL, \"created_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
